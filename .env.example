# Salin ke .env.local untuk pengembangan lokal. Di Vercel, isi lewat
# Project → Settings → Environment Variables (tandai Sensitive).

# Akar REST API WordPress (tanpa garis miring di ujung).
WP_API_URL=https://theglobal-review.com/wp-json

# Secret webhook revalidasi — nilai yang sama dengan konstanta
# TGR_REVALIDATE_SECRET di wp-config.php. Buat dengan: openssl rand -hex 32
# Boleh beberapa nilai dipisah koma untuk rotasi bertahap.
REVALIDATE_SECRET=

# Batas arsip: tulisan yang terbit SEBELUM waktu ini tidak ditampilkan
# (konten 2022 ke bawah diarsipkan terpisah atas arahan GFI). Kosongkan
# nilainya untuk menayangkan seluruh arsip kembali.
WP_ARCHIVE_AFTER=2022-12-31T23:59:59

# Application Password (Pengguna → profil → Kata Sandi Aplikasi) untuk
# operasi tulis: penataan rubrik, pengisian data uji, unggah media. Jangan
# pernah di-commit atau diberi awalan NEXT_PUBLIC_.
# WP_APP_USER=
# WP_APP_PASSWORD=
