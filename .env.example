# Salin ke .env.local untuk pengembangan lokal. Di produksi (Railway), isi
# lewat dasbor service → Variables (secret: centang "Seal" agar nilainya
# tidak bisa dibaca lagi); lihat docs/hosting-railway.md. Di server sendiri
# (Docker) lihat docs/self-host.md. WP_API_URL dan WP_ARCHIVE_AFTER
# dibutuhkan saat build DAN runtime; REVALIDATE_SECRET hanya runtime.
#
# Hanya tiga variabel di bawah yang dibaca kode src/. Alamat situs
# (canonical, sitemap, feed) TIDAK diambil dari env: nilainya di
# src/data/site.ts, jadi pindah host tidak perlu SITE_URL.

# Akar REST API WordPress (tanpa garis miring di ujung). Pasca-cutover
# domain (24 Agu 2026) WordPress hidup di cms.* — apex dilayani situs Next,
# jadi nilai lama theglobal-review.com/wp-json kini menjawab HTML 404.
WP_API_URL=https://cms.theglobal-review.com/wp-json

# Secret webhook revalidasi — nilai yang sama dengan konstanta
# TGR_REVALIDATE_SECRET di wp-config.php. Buat dengan: openssl rand -hex 32
# Boleh beberapa nilai dipisah koma untuk rotasi bertahap.
REVALIDATE_SECRET=

# Batas arsip: tulisan yang terbit SEBELUM waktu ini tidak ditampilkan
# (konten 2022 ke bawah diarsipkan terpisah atas arahan GFI). Kosongkan
# nilainya untuk menayangkan seluruh arsip kembali.
WP_ARCHIVE_AFTER=2022-12-31T23:59:59

# Application Password (Pengguna → profil → Kata Sandi Aplikasi) untuk
# operasi tulis: penataan rubrik, pengisian data uji, unggah media. Jangan
# pernah di-commit atau diberi awalan NEXT_PUBLIC_.
# WP_APP_USER=
# WP_APP_PASSWORD=

# --- Hosting (bukan dibaca src/, tapi dibaca Node/Next/glibc) ---------------
#
# Railway: isi MALLOC_ARENA_MAX di Variables (docs/hosting-railway.md §3).
# Image Docker: keempatnya sudah diberi nilai di Dockerfile; tidak perlu
# diisi kecuali ingin menimpa.
#
# glibc membuat banyak arena malloc per thread; 2 menahan RSS di luar heap V8.
# MALLOC_ARENA_MAX=2
# Port dan alamat dengar server.js standalone (Docker). next dev/start
# memakai PORT juga; HOSTNAME hanya dibaca server standalone.
# PORT=3000
# HOSTNAME=0.0.0.0
# Build saja: "standalone" menghasilkan .next/standalone untuk Dockerfile.
# Jangan dipasang di Railway — di sana startCommand memanggil next start.
# NEXT_OUTPUT=standalone

# --- Skrip CLI (tidak dibaca aplikasi) ---------------------------------------
#
# scripts/pantau-artikel-terbaru.mjs (dipakai .github/workflows/pantau-situs.yml)
# SITE_URL=https://www.theglobal-review.com
# WP_URL=https://cms.theglobal-review.com
# GRACE_MENIT=20
#
# wordpress/rest/*.mjs — penanda sekali jalan, bukan konfigurasi tetap:
# APPLY=1     terapkan perubahan (tanpa ini skrip hanya dry-run)
# TIMPA=1     sorotan.mjs: timpa nilai yang sudah ada
# CONTOH=30   sorotan.mjs: jumlah contoh yang ditampilkan
# SEBELUM=2023-01-01T00:00:00   arsipkan-lama.mjs: batas tanggal
# BATAS=      arsipkan-lama.mjs: jumlah maksimum tulisan per jalan
