# Salin ke .env.local untuk pengembangan lokal. Di Vercel, isi lewat
# Project → Settings → Environment Variables (tandai Sensitive).

# Akar REST API WordPress (tanpa garis miring di ujung).
WP_API_URL=https://theglobal-review.com/wp-json

# Secret webhook revalidasi — nilai yang sama dengan konstanta
# TGR_REVALIDATE_SECRET di wp-config.php. Buat dengan: openssl rand -hex 32
# Boleh beberapa nilai dipisah koma untuk rotasi bertahap.
REVALIDATE_SECRET=

# Fase 2 (belum dipakai): Application Password untuk endpoint non-publik
# (polls) dan unggah media. Jangan pernah di-commit atau diberi awalan
# NEXT_PUBLIC_.
# WP_APP_USER=
# WP_APP_PASSWORD=
